{
    "manifest_version": 3,
    "name": "YouTube AI Video Translator",
    "version": "0.1",
    "description": "Get transcript from YouTube video and translate it using backend AI service.",
    "permissions": [
        "activeTab",
        "storage",
        "webNavigation",
        "scripting"
    ],
    "host_permissions": [
        "https://www.youtube.com/*",
        "http://localhost:5000/*"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "*://www.youtube.com/watch*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icon.svg"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "action": {
        "default_icon": "icon.svg"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "youtube-translator@koolsg.local",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    }
}