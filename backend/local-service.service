[Unit]
Description=Local Service Translation Server
After=network.target
# 5분(300초) 안에 5번 실패하면 재시작 중단 (안전장치)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=forking
# 절대 경로로 프로젝트 루트를 설정하세요
WorkingDirectory=/home/koolsg/Projects/local-service/backend
Environment=VIRTUAL_ENV=/home/koolsg/Projects/local-service/backend/.venv
ExecStart=/home/koolsg/bin/local-service
ExecStop=/home/koolsg/Projects/local-service/backend/server.sh stop
PIDFile=/home/koolsg/Projects/local-service/backend/app.pid
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
